    "goldenBoot": { "player": "Hristo Stoichkov", "nationality": "Bulgaria", "club": "FC Barcelona", "goals": 6, "note": "Stoichkov and Oleg Salenko (Russia) both finished the tournament with 6 goals and 1 assist. Under FIFA's tiebreak rules (goals, then assists) the two could not be separated, so the Golden Boot/Golden Shoe was officially shared by both players — the only time this award has been jointly awarded. See silverBoot for Salenko." },
    "silverBoot": { "player": "Oleg Salenko", "nationality": "Russia", "club": "CD Logroñés", "goals": 6, "note": "Salenko set the World Cup record for most goals in a single match (5, in Russia's 6-1 win over Cameroon) and shares the joint 1994 Golden Boot with Hristo Stoichkov, despite Russia being eliminated in the group stage." },
    "goldenGlove": { "player": "Michel Preud'homme", "nationality": "Belgium", "club": "KV Mechelen", "note": "Known at the time as the Lev Yashin Award — this was the first World Cup at which the award for best goalkeeper was given. It was renamed the Golden Glove in 2010." }
  },
